{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerificationResult",
  "type": "object",
  "required": ["schema_version", "protocol_version", "kind", "result", "exit_code", "source", "summary", "checks"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "protocol_version": { "type": "string" },
    "kind": { "type": "string", "const": "verification_result" },
    "result": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "UNSUPPORTED"] },
    "exit_code": { "type": "integer", "enum": [0, 1, 2, 3] },
    "source": { "type": "string", "enum": ["checks_tsv", "auto_detected"] },
    "summary": {
      "type": "object",
      "required": ["checks_defined", "checks_run", "required_run", "passed", "failed", "blocked", "optional_skipped"],
      "properties": {
        "checks_defined": { "type": "integer" },
        "checks_run": { "type": "integer" },
        "required_run": { "type": "integer" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "blocked": { "type": "integer" },
        "optional_skipped": { "type": "integer" }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "requirement", "status", "working_directory", "exit_code", "duration_ms", "reason_code"],
        "properties": {
          "id": { "type": "string" },
          "requirement": { "type": "string", "enum": ["required", "optional"] },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "SKIPPED_OPTIONAL"] },
          "working_directory": { "type": "string" },
          "exit_code": { "type": ["integer", "null"] },
          "duration_ms": { "type": "integer" },
          "reason_code": { "type": ["string", "null"] }
        }
      }
    }
  }
}
