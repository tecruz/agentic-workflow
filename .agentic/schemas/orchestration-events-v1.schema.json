{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tecruz.github.io/agentic-workflow/schemas/orchestration-events-v1.schema.json",
  "title": "OrchestrationEvent",
  "description": "Schema for a single JSONL event object emitted by coordinator.sh --events / coordinator.ps1 -Events. Each line of the event stream is one JSON object validated against exactly one of the four event definitions below.",
  "oneOf": [
    { "$ref": "#/definitions/orchestration_started" },
    { "$ref": "#/definitions/worker_started" },
    { "$ref": "#/definitions/worker_completed" },
    { "$ref": "#/definitions/orchestration_completed" }
  ],
  "definitions": {
    "event_name": {
      "type": "object",
      "required": ["event"],
      "properties": {
        "event": { "type": "string" }
      }
    },
    "orchestration_started": {
      "allOf": [
        { "$ref": "#/definitions/event_name" },
        {
          "properties": {
            "event": { "const": "orchestration_started" }
          },
          "additionalProperties": false
        }
      ]
    },
    "worker_started": {
      "allOf": [
        { "$ref": "#/definitions/event_name" },
        {
          "required": ["worker_id", "working_directory"],
          "properties": {
            "event": { "const": "worker_started" },
            "worker_id": { "type": "string" },
            "working_directory": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "worker_completed": {
      "allOf": [
        { "$ref": "#/definitions/event_name" },
        {
          "required": ["worker_id", "status", "exit_code", "duration_ms", "working_directory", "reason_code"],
          "properties": {
            "event": { "const": "worker_completed" },
            "worker_id": { "type": "string" },
            "status": { "enum": ["PASS", "FAIL", "BLOCKED", "SKIPPED"] },
            "exit_code": { "type": ["integer", "null"] },
            "duration_ms": { "type": "integer", "minimum": 0 },
            "working_directory": { "type": "string" },
            "reason_code": { "enum": ["WORKER_FAILED", "WORKER_BLOCKED", "TOOLING_UNAVAILABLE", null] }
          },
          "additionalProperties": false
        },
        {
          "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] },
          "then": {
            "properties": {
              "exit_code": { "const": 0 },
              "reason_code": { "const": null }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "FAIL" } }, "required": ["status"] },
          "then": {
            "properties": {
              "exit_code": { "type": "integer", "minimum": 1 },
              "reason_code": { "const": "WORKER_FAILED" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "BLOCKED" } }, "required": ["status"] },
          "then": {
            "properties": {
              "exit_code": { "const": null },
              "reason_code": { "enum": ["WORKER_BLOCKED", "TOOLING_UNAVAILABLE"] }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "SKIPPED" } }, "required": ["status"] },
          "then": {
            "properties": {
              "exit_code": { "const": null },
              "reason_code": { "enum": ["WORKER_BLOCKED", "TOOLING_UNAVAILABLE"] }
            }
          }
        }
      ]
    },
    "orchestration_completed": {
      "allOf": [
        { "$ref": "#/definitions/event_name" },
        {
          "required": ["result", "exit_code"],
          "properties": {
            "event": { "const": "orchestration_completed" },
            "result": { "enum": ["PASS", "FAIL", "BLOCKED"] },
            "exit_code": { "type": "integer", "enum": [0, 1, 2] }
          },
          "additionalProperties": false
        },
        {
          "comment": "Terminal events must pair result with the state-model exit code (PASS=0, FAIL=1, BLOCKED=2). Cross-event ordering — exactly one terminal event per stream, emitted last — is a producer contract covered by the test suites; JSON Schema cannot express ordering across JSONL lines.",
          "if": { "properties": { "result": { "const": "PASS" } }, "required": ["result"] },
          "then": { "properties": { "exit_code": { "const": 0 } } }
        },
        {
          "if": { "properties": { "result": { "const": "FAIL" } }, "required": ["result"] },
          "then": { "properties": { "exit_code": { "const": 1 } } }
        },
        {
          "if": { "properties": { "result": { "const": "BLOCKED" } }, "required": ["result"] },
          "then": { "properties": { "exit_code": { "const": 2 } } }
        }
      ]
    }
  }
}
