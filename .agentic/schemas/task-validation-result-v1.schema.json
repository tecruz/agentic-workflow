{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskValidationResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "kind", "mode", "result", "exit_code", "task_file", "profile", "task_status", "diagnostics"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "protocol_version": { "type": "string", "const": "1.9.0" },
    "kind": { "type": "string", "const": "task_validation_result" },
    "mode": { "type": "string", "enum": ["standard", "handoff"] },
    "result": { "type": "string", "enum": ["VALID", "INVALID", "BLOCKED"] },
    "exit_code": { "type": "integer", "enum": [0, 1, 2] },
    "task_file": { "type": "string" },
    "profile": { "type": ["string", "null"], "enum": ["prototype", "standard", "high-assurance", null] },
    "task_status": { "type": ["string", "null"], "enum": ["planned", "in-progress", "blocked", "done", null] },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "section", "identifier", "message"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "TASK_FILE_NOT_FOUND",
              "PROFILE_UNKNOWN",
              "PROFILE_DECLARATION_INVALID",
              "STATUS_INVALID",
              "STATUS_DECLARATION_INVALID",
              "UPDATED_INVALID",
              "SECTION_MISSING",
              "SECTION_DUPLICATE",
              "CRITERION_INVALID",
              "EVIDENCE_MAPPING_INVALID",
              "APPROVAL_INVALID",
              "APPROVAL_UNRESOLVED",
              "PROTOTYPE_DECLARATION_INVALID",
              "EVIDENCE_UNRESOLVED",
              "STATUS_NOT_DONE"
            ]
          },
          "section": { "type": ["string", "null"] },
          "identifier": { "type": ["string", "null"] },
          "message": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "result": { "const": "VALID" } }, "required": ["result"] },
      "then": { "properties": { "exit_code": { "const": 0 } } }
    },
    {
      "if": { "properties": { "result": { "const": "INVALID" } }, "required": ["result"] },
      "then": { "properties": { "exit_code": { "const": 1 }, "diagnostics": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "result": { "const": "BLOCKED" } }, "required": ["result"] },
      "then": { "properties": { "exit_code": { "const": 2 }, "diagnostics": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "exit_code": { "const": 0 } }, "required": ["exit_code"] },
      "then": { "properties": { "diagnostics": { "type": "array", "maxItems": 0 } } }
    }
  ]
}
